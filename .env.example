# TMDB (https://www.themoviedb.org/settings/api — v4 API Read Access Token)
TMDB_ACCESS_TOKEN=

# PG — 로컬은 compose.local.yml의 postgres 서비스 (gonamu-cineseek-postgres)
PG_HOST=localhost
PG_PORT=5432
PG_DB=cineseek
PG_USER=jjong
PG_PASSWORD=jjong

# Qdrant / Embedding (컨테이너 내부 주소는 compose가 지정, 아래는 IDE 직접 실행용 기본값)
QDRANT_COLLECTION=movies
EMBED_DEVICE=cpu          # 컨테이너는 CPU 고정 (Docker는 MPS 사용 불가)
EMBED_MODEL=BAAI/bge-m3

# 수집 범위
TMDB_PAGES=50             # discover 페이지 수 (페이지당 20건)
