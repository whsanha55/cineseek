# api(kotlin) 환경변수 — cp .env.example .env 후 채운다
# compose는 env_file로, IDE/bootRun(작업 디렉터리 kotlin/)은 spring.config.import로 읽는다
# 나머지(PG_*, QDRANT_*, EMBED_URL)는 application.yml 기본값으로 돈다

# TMDB v4 Read Access Token (https://www.themoviedb.org/settings/api)
TMDB_ACCESS_TOKEN=

# 분위기 태깅용 OpenAI 호환 API (선택 — 키가 비어 있으면 태깅을 건너뛴다)
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
