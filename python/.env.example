# TMDB (https://www.themoviedb.org/settings/api — v4 API Read Access Token)
TMDB_ACCESS_TOKEN=<여기에 v4 Read Access Token 입력>

# PG (infra postgres 컨테이너, cineseek DB)
PG_HOST=localhost
PG_PORT=5432
PG_DB=cineseek
PG_USER=cineseek
PG_PASSWORD=cineseek

# Qdrant (cineseek-qdrant 컨테이너)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=movies

# Embedding
EMBED_DEVICE=mps
EMBED_MODEL=BAAI/bge-m3

# 수집 범위
TMDB_PAGES=50          # discover 페이지 수 (페이지당 20건 → 기본 ~1000건 후보)
TMDB_WORKERS=10        # detail 병렬 fetch 스레드 수
